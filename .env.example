# ---- keys (never commit the real .env) ----
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=sk_...

# ---- voice (docs/voice.md — this ID *is* Roasty) ----
ELEVENLABS_VOICE_ID=Ym1lepVbBruoa0yJFohT
# the Wall Label narrator (/label bench)
ELEVENLABS_VOICE_ID_LABEL=INlzb6xeYqy5GoEu1Oel

# ---- Claude models ----
# The Guesser only names what it sees -> fastest model. The Writer is where
# the comedy lives -> Sonnet, with the bible prefix prompt-cached.
CLAUDE_MODEL_GUESS=claude-haiku-4-5
CLAUDE_MODEL_WRITE=claude-sonnet-5
CLAUDE_MODEL_CLOSE=claude-sonnet-5
# Wall Label bench (/label) writer. Not live, so it always thinks; effort
# low | medium | high | xhigh | max
CLAUDE_MODEL_LABEL=claude-opus-5-5
CLAUDE_EFFORT_LABEL=high
# adaptive thinking costs seconds per line. off | adaptive
CLAUDE_THINKING=off

# ---- ElevenLabs models ----
# FAST = mid-round lines. RICH = closing roast (higher quality, slower).
# eleven_v3 is the model that honours [tags]; if you switch FAST to
# eleven_turbo_v2_5 / eleven_flash_v2_5 the server strips tags automatically.
ELEVEN_MODEL_FAST=eleven_flash_v2_5
ELEVEN_MODEL_RICH=eleven_v3
ELEVEN_FORMAT_FAST=mp3_22050_32
ELEVEN_FORMAT_RICH=mp3_44100_128
# Wall Label narration. v3 performs the bible's delivery tags ([curious] ...);
# a v2 model gets smooth stability/style sliders but the tags are stripped.
ELEVEN_MODEL_LABEL=eleven_v3
ELEVEN_FORMAT_LABEL=mp3_44100_128
# music bed under the rendered video (tracks in music/), 0..1; it also
# ducks whenever he talks
LABEL_MUSIC_VOLUME=0.4
# stability low = instability IS the character (v3 accepts 0.0 / 0.5 / 1.0)
ELEVEN_STABILITY=0.0
ELEVEN_SIMILARITY=0.75
ELEVEN_STYLE=0.6
ELEVEN_SPEED=1.0

# ---- server ----
PORT=8787
HOST=0.0.0.0

# streaming latency hint, 0..4 (eleven_v3 rejects it; turbo/flash accept it)
ELEVEN_LATENCY_FAST=4
ELEVEN_LATENCY_RICH=0
